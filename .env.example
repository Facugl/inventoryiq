POSTGRES_DB=inventoryiq
POSTGRES_USER=inventoryiq
POSTGRES_PASSWORD=inventoryiq
# 5433 y no 5432: una instalacion nativa de PostgreSQL en la maquina de
# desarrollo suele ocupar el 5432, y el contenedor igual levanta (Windows
# deja atar el puerto dos veces) pero las conexiones desde el host se van
# al server nativo. Esto solo afecta al puerto publicado hacia el host:
# dentro de la red de compose el backend sigue hablando con postgres:5432.
POSTGRES_PORT=5433

BACKEND_PORT=8080

FRONTEND_PORT=5173
